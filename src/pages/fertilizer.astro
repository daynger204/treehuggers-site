---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentBlocks from '../components/ContentBlocks.astro';
const page = await getEntry('pages', 'fertilizer');
if (!page) throw new Error('Missing pages/fertilizer');
const d = page.data;
const blocks = d.blocks;
---
<BaseLayout title={d.title} description={d.description} canonicalPath={d.canonicalPath} ogTitle={d.ogTitle}>
  <section class="page-section inner-hero-space">
    <div class="container prose">
      <h2 class="page-title">{d.h1}</h2>
      <div class="text-center stack-band">
        <ContentBlocks blocks={blocks.slice(0, 1)} images={d.images} />
      </div>
      <div class="stack-band">
        <ContentBlocks blocks={blocks.slice(1, 5)} images={d.images} />
      </div>
      <div class="split split--half split--media-first">
        <div class="split__copy">
          <ContentBlocks blocks={blocks.slice(6, 11)} images={d.images} />
        </div>
        <div class="split__media">
          <ContentBlocks blocks={blocks.slice(5, 6)} images={d.images} />
        </div>
      </div>
      <div class="stack-band">
        <ContentBlocks blocks={blocks.slice(11)} images={d.images} />
      </div>
    </div>
  </section>
</BaseLayout>
