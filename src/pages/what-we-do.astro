---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveImage } from '../lib/images';

const page = await getEntry('pages', 'what-we-do');
if (!page) throw new Error('Missing pages/what-we-do');
const d = page.data;
const team = resolveImage(d.images, 'team');
---

<BaseLayout title={d.title} description={d.description} canonicalPath={d.canonicalPath} ogTitle={d.ogTitle}>
  <section class="page-section inner-hero-space">
    <div class="container">
      <h1 class="page-title">{d.h1}</h1>
      <div class="page-intro">
        {d.blocks.filter((b) => b.type === 'paragraph').map((b) => <p>{b.type === 'paragraph' && b.text}</p>)}
      </div>
      <div class="grid-2 grid-2--top services-band mt-2">
        <div class="text-center">
          <h3>OUR SERVICES</h3>
          <ul class="services-list">
            {
              d.services!.map((s) => (
                <li>
                  {s.href ? <a href={s.href}>{s.label}</a> : s.label}
                  {s.suffix ?? ''}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="img-leaf img-frame team-frame">
          <Image src={team.src} alt={team.alt} widths={[500, 800, 1200]} sizes="(max-width: 767px) 88vw, 504px" quality={80} />
        </div>
      </div>
      {
        d.quote && (
          <figure class="site-quote">
            <blockquote>“{d.quote.text}”</blockquote>
            {d.quote.source && <figcaption class="source">{d.quote.source}</figcaption>}
          </figure>
        )
      }
    </div>
  </section>
</BaseLayout>
