---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentBlocks from '../components/ContentBlocks.astro';
const page = await getEntry('pages', 'emeraldashborer');
if (!page) throw new Error('Missing pages/emeraldashborer');
const d = page.data;
const blocks = d.blocks;
---
<BaseLayout title={d.title} description={d.description} canonicalPath={d.canonicalPath} ogTitle={d.ogTitle}>
  <section class="page-section inner-hero-space">
    <div class="container prose">
      <h2 class="page-title">{d.h1}</h2>
      <ContentBlocks blocks={blocks.slice(0, 1)} images={d.images} />
      <div class="text-center stack-band">
        <ContentBlocks blocks={blocks.slice(1, 6)} images={d.images} />
      </div>
      <ContentBlocks blocks={blocks.slice(6, 8)} images={d.images} />
      <div class="text-center stack-band">
        <ContentBlocks blocks={blocks.slice(8, 13)} images={d.images} />
      </div>
      <ContentBlocks blocks={blocks.slice(13, 14)} images={d.images} />
      <div class="text-center stack-band">
        <ContentBlocks blocks={blocks.slice(14, 15)} images={d.images} />
      </div>
      <ContentBlocks blocks={blocks.slice(15)} images={d.images} />
    </div>
  </section>
</BaseLayout>
