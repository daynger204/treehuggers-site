---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogTitle?: string;
  flushHeader?: boolean;
}
const {
  title,
  description,
  canonicalPath,
  ogTitle,
  flushHeader = false,
} = Astro.props;

const site = 'https://www.treehuggerswinnipeg.com';
const canonical = canonicalPath === '/' ? `${site}/` : `${site}${canonicalPath}`;
const ogUrl = canonicalPath === '/' ? site : `${site}${canonicalPath}`;
const shareImage = `${site}/images/og-logo.jpg`;
const pageOgTitle = ogTitle ?? title;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    url: site,
    name: 'Treehuggers',
    description,
    image: `${site}/images/logo-beige.png`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    legalName: 'Treehuggers',
    email: 'info@treehuggerswinnipeg.com',
    telephone: '+1-204-297-0767',
    url: site,
    sameAs: [
      'https://www.instagram.com/treehuggers.winnipeg/',
      'http://www.facebook.com/treehuggerswpg',
      'mailto:info@treehuggerswinnipeg.com',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: 'Treehuggers',
    telephone: '+1-204-297-0767',
    email: 'info@treehuggerswinnipeg.com',
    url: site,
    areaServed: 'Winnipeg and Southern Manitoba',
    image: `${site}/images/logo-beige.png`,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <meta property="og:site_name" content="Treehuggers" />
    <meta property="og:title" content={pageOgTitle} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="500" />
    <meta property="og:image:height" content="500" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageOgTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:url" content={ogUrl} />

    <!--
      Display font: Fraunces (Google Fonts) stands in for New Spirit.
      New Spirit is commercial; web licence not verified. Controlled by --font-display.
      Body: Work Sans.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Work+Sans:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <!--
      Same two async gtag installs as the live Squarespace head:
      code-injected Google Ads, then native GA4. No conversion events in the page.
      Not copied: gtag('set', 'developer_id.dZjQwMz', true) on the GA4 tag.
      That is Squarespace's platform developer id, not a site measurement setting.
    -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-920029337"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-920029337');
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-7SV4KCKDC9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-7SV4KCKDC9');
    </script>
    <!--
      Meta Pixel base code, PageView only.
      Not copied: n.agent='plsquarespace' (Squarespace's installer agent).
      The noscript image is part of Meta's standard snippet; the live
      Squarespace injection does not include it.
    -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '429595691161619');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=429595691161619&ev=PageView&noscript=1" /></noscript>
  </head>
  <body>
    <a class="sr-only" href="#page">Skip to Content</a>
    <Header currentPath={canonicalPath} />
    <main id="page" class:list={['page-main', { 'page-main--flush': flushHeader }]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
