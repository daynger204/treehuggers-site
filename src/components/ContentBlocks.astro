---
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';

interface ImgRef {
  id: string;
  file: string;
  alt: string;
}
interface Props {
  blocks: any[];
  images: ImgRef[];
}
const { blocks, images } = Astro.props;

function formatText(text: string) {
  // Allow intentional HTML; also convert **bold** markdown
  return text
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\n/g, '<br />');
}
---

{
  blocks.map((block) => {
    switch (block.type) {
      case 'paragraph':
        return (
          <p class:list={{ 'page-intro': block.center, 'page-intro--wide': block.center }} set:html={formatText(block.text)} />
        );
      case 'heading': {
        if (block.level === 2) return <h2>{block.text}</h2>;
        if (block.level === 4) return <h4>{block.text}</h4>;
        return <h3>{block.text}</h3>;
      }
      case 'image': {
        const img = resolveImage(images, block.imageId);
        const isWideImage = block.maxWidth >= 1020;
        const style = block.maxWidth
          ? `max-width: ${block.maxWidth}px;${isWideImage ? '' : ' margin: 1.5rem auto;'}`
          : 'margin: 1.5rem auto;';
        return (
          <div>
            <div class:list={['img-leaf', { 'img-leaf--wide': isWideImage }]} style={style}>
              <Image
                src={img.src}
                alt={img.alt}
                widths={[400, 640, 900, 1200]}
                sizes={isWideImage ? '(max-width: 767px) 90vw, 1020px' : '(max-width: 767px) 90vw, 800px'}
                quality={80}
              />
            </div>
            {block.caption && <p class="text-center mt-1">{block.caption}</p>}
          </div>
        );
      }
      case 'imageText': {
        const img = resolveImage(images, block.imageId);
        const style = [
          block.spaceAfter ? `margin-bottom: ${block.spaceAfter}px` : '',
        ].filter(Boolean).join('; ');
        return (
          <div
            class:list={[
              'grid-2',
              'grid-2--top',
              'image-text-block',
              { 'mt-2': !block.tightTop },
            ]}
            style={style || undefined}
          >
            <div>
              {block.heading && <h3>{block.heading}</h3>}
              {block.paragraphs.map((text: string) => <p set:html={formatText(text)} />)}
              {block.items && (
                <ul class="content-list">
                  {block.items.map((item: string) => <li set:html={formatText(item)} />)}
                </ul>
              )}
              {block.button && (
                <p class="mt-2">
                  <a class="btn btn--primary" href={block.button.href}>{block.button.label}</a>
                </p>
              )}
              {block.afterParagraphs?.map((text: string) => <p set:html={formatText(text)} />)}
            </div>
            <div class="img-leaf">
              <Image
                src={img.src}
                alt={img.alt}
                widths={[400, 640, 900, 1024]}
                sizes="(max-width: 767px) 90vw, 50vw"
                quality={80}
              />
            </div>
          </div>
        );
      }
      case 'divider':
        return <hr class="content-divider" />;
      case 'videoList':
        return (
          <div class="grid-2 grid-2--top video-list-block">
            <div>
              <h3>{block.heading}</h3>
              <ul class="content-list">
                {block.items.map((item: string) => <li set:html={item} />)}
              </ul>
            </div>
            <div class="video-list-block__media">
              {block.videos.map((video: { youtubeId: string; title: string; srcExtra?: string }) => {
                const q = video.srcExtra ? `?${video.srcExtra}` : '?feature=oembed';
                return (
                  <div class="video-wrap">
                    <iframe
                      src={`https://www.youtube.com/embed/${video.youtubeId}${q}`}
                      title={video.title}
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                      loading="lazy"
                    />
                  </div>
                );
              })}
              {block.caption && <p>{block.caption}</p>}
            </div>
          </div>
        );
      case 'textImagePair': {
        const left = resolveImage(images, block.leftId);
        const right = resolveImage(images, block.rightId);
        return (
          <div class="grid-2 grid-2--top text-image-pair mt-2">
            <div>
              {block.paragraphs.map((text: string) => <p set:html={formatText(text)} />)}
              <p class="mt-2">
                <a class="btn btn--primary" href={block.button.href}>{block.button.label}</a>
              </p>
            </div>
            <div class="grid-2 grid-2--images text-image-pair__images">
              <div class="img-leaf">
                <Image src={left.src} alt={left.alt} widths={[400, 640, 900]} sizes="(max-width: 767px) 90vw, 22vw" quality={80} />
              </div>
              <div class="img-leaf">
                <Image src={right.src} alt={right.alt} widths={[400, 640, 900]} sizes="(max-width: 767px) 90vw, 22vw" quality={80} />
              </div>
            </div>
          </div>
        );
      }
      case 'imagePair': {
        const left = resolveImage(images, block.leftId);
        const right = resolveImage(images, block.rightId);
        return (
          <div class="grid-2 grid-2--images mt-2">
            <div>
              <div class="img-leaf">
                <Image
                  src={left.src}
                  alt={left.alt}
                  widths={[400, 640, 900]}
                  sizes="(max-width: 767px) 90vw, 45vw"
                  quality={80}
                />
              </div>
              {block.leftCaption && <p class="text-center mt-1">{block.leftCaption}</p>}
            </div>
            <div>
              <div class="img-leaf">
                <Image
                  src={right.src}
                  alt={right.alt}
                  widths={[400, 640, 900]}
                  sizes="(max-width: 767px) 90vw, 45vw"
                  quality={80}
                />
              </div>
              {block.rightCaption && <p class="text-center mt-1">{block.rightCaption}</p>}
            </div>
          </div>
        );
      }
      case 'list':
        return (
          <ul class="content-list">
            {block.items.map((item: string) => (
              <li set:html={item} />
            ))}
          </ul>
        );
      case 'button':
        return (
          <p class="text-center mt-2">
            <a class="btn btn--primary" href={block.href}>
              {block.label}
            </a>
          </p>
        );
      case 'video': {
        const q = block.srcExtra ? `?${block.srcExtra}` : '?feature=oembed';
        return (
          <div class="video-wrap">
            <iframe
              src={`https://www.youtube.com/embed/${block.youtubeId}${q}`}
              title={block.title}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            />
          </div>
        );
      }
      case 'html':
        return <div set:html={block.html} />;
      default:
        return null;
    }
  })
}
