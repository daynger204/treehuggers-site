---
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';

interface ImgRef {
  id: string;
  file: string;
  alt: string;
}
interface Props {
  blocks: any[];
  images: ImgRef[];
}
const { blocks, images } = Astro.props;

function formatText(text: string) {
  // Allow intentional HTML; also convert **bold** markdown
  return text
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\n/g, '<br />');
}

function frameStyle(block: { ratio?: string; ratioMobile?: string }) {
  if (!block.ratio) return undefined;
  const mobile = block.ratioMobile ? `; --frame-m: ${block.ratioMobile}` : '';
  return `--frame: ${block.ratio}${mobile}`;
}
---

{
  blocks.map((block) => {
    switch (block.type) {
      case 'paragraph':
        return (
          <p
            class:list={{ 'page-intro': block.center, 'page-intro--wide': block.center, 'text-14': block.small }}
            set:html={formatText(block.text)}
          />
        );
      case 'heading': {
        if (block.level === 2) return <h2>{block.text}</h2>;
        if (block.level === 4) return <h4>{block.text}</h4>;
        return <h3>{block.text}</h3>;
      }
      case 'image': {
        const img = resolveImage(images, block.imageId);
        const framed = Boolean(block.ratio);
        const isWideImage = framed || block.maxWidth >= 1020;
        const style = framed
          ? frameStyle(block)
          : block.maxWidth
            ? `max-width: ${block.maxWidth}px; margin: 1.5rem auto;`
            : undefined;
        return (
          <div class="stack-band">
            <div class:list={['img-leaf', { 'img-frame': framed, 'img-spaced': !framed }]} style={style}>
              <Image
                src={img.src}
                alt={img.alt}
                widths={[400, 640, 900, 1200]}
                sizes={isWideImage ? '(max-width: 767px) 88vw, 1020px' : '(max-width: 767px) 88vw, 800px'}
                quality={80}
              />
            </div>
            {block.caption && <p class="text-center mt-1">{block.caption}</p>}
          </div>
        );
      }
      case 'imageText': {
        const img = resolveImage(images, block.imageId);
        const style = block.spaceAfter ? `margin-bottom: ${block.spaceAfter}px` : undefined;
        return (
          <div
            class:list={[
              'split',
              block.layout ? `split--${block.layout}` : 'split--half',
              { 'split--media-first': block.mediaFirst, 'split--tight': block.tightTop },
            ]}
            style={style}
          >
            <div class="split__copy">
              {block.heading && <h3>{block.heading}</h3>}
              {block.paragraphs.map((text: string) => <p set:html={formatText(text)} />)}
              {block.items && (
                <ul class="content-list">
                  {block.items.map((item: string) => <li set:html={formatText(item)} />)}
                </ul>
              )}
              {block.button && (
                <p
                  class:list={['btn-row', 'btn-row--start', {
                    'btn-row--pad-bottom': Boolean(block.afterParagraphs?.length),
                    'btn-row--pad-top': Boolean(block.button.padTop),
                  }]}
                  style={block.button.padTop ? `--btn-pad-top: ${block.button.padTop}px` : undefined}
                >
                  <a class="btn btn--primary" href={block.button.href}>{block.button.label}</a>
                </p>
              )}
              {block.afterParagraphs?.map((text: string) => <p class="consult-note" set:html={formatText(text)} />)}
            </div>
            <div
              class:list={['split__media', block.corners === 'tl' ? 'img-leaf-tl' : block.corners === 'br' ? 'img-leaf-br' : 'img-leaf', { 'img-frame': Boolean(block.ratio) }]}
              style={[frameStyle(block), block.imageShift ? `--img-shift: ${block.imageShift}px` : ''].filter(Boolean).join('; ') || undefined}
            >
              <Image
                src={img.src}
                alt={img.alt}
                widths={[400, 640, 900, 1024]}
                sizes="(max-width: 767px) 88vw, 520px"
                quality={80}
              />
            </div>
          </div>
        );
      }
      case 'divider':
        return <hr class="content-divider" />;
      case 'videoList':
        return (
          <div class:list={['split', 'video-list-block', block.layout ? `split--${block.layout}` : 'split--how']}>
            <div class="split__copy">
              <h3>{block.heading}</h3>
              <ul class="content-list">
                {block.items.map((item: string) => <li set:html={item} />)}
              </ul>
            </div>
            <div class="split__media video-list-block__media">
              {block.videos.map((video: { youtubeId: string; title: string; srcExtra?: string }) => {
                const q = video.srcExtra ? `?${video.srcExtra}` : '?feature=oembed';
                return (
                  <div class="video-wrap">
                    <iframe
                      src={`https://www.youtube.com/embed/${video.youtubeId}${q}`}
                      title={video.title}
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                      loading="lazy"
                    />
                  </div>
                );
              })}
              {block.caption && <p>{block.caption}</p>}
            </div>
          </div>
        );
      case 'textImagePair': {
        const left = resolveImage(images, block.leftId);
        const right = resolveImage(images, block.rightId);
        const frame = frameStyle(block);
        return (
          <div class:list={['split', block.layout ? `split--${block.layout}` : 'split--photos']}>
            <div class="split__copy">
              {block.paragraphs.map((text: string) => <p set:html={formatText(text)} />)}
              <p class="btn-row btn-row--start btn-row--pad">
                <a class="btn btn--primary" href={block.button.href}>{block.button.label}</a>
              </p>
            </div>
            <div class="split__media grid-2 grid-2--images">
              <div class:list={['img-leaf-tl', { 'img-frame': Boolean(frame) }]} style={frame}>
                <Image src={left.src} alt={left.alt} widths={[400, 640, 900]} sizes="(max-width: 767px) 88vw, 333px" quality={80} />
              </div>
              <div class:list={['img-leaf-br', { 'img-frame': Boolean(frame) }]} style={frame}>
                <Image src={right.src} alt={right.alt} widths={[400, 640, 900]} sizes="(max-width: 767px) 88vw, 333px" quality={80} />
              </div>
            </div>
          </div>
        );
      }
      case 'imagePair': {
        const left = resolveImage(images, block.leftId);
        const right = resolveImage(images, block.rightId);
        const frame = frameStyle(block);
        const leftRadius = block.pairedCorners ? 'img-leaf-tl' : 'img-leaf';
        const rightRadius = block.pairedCorners ? 'img-leaf-br' : 'img-leaf';
        const rightStyle = [frame, block.rightZoom ? `--img-zoom: ${block.rightZoom}` : ''].filter(Boolean).join('; ') || undefined;
        return (
          <div class="grid-2 grid-2--images mt-2" style={block.spaceBelow ? `padding-bottom: ${block.spaceBelow}px` : undefined}>
            <div>
              <div class:list={[leftRadius, { 'img-frame': Boolean(frame) }]} style={frame}>
                <Image
                  src={left.src}
                  alt={left.alt}
                  widths={[400, 640, 900]}
                  sizes="(max-width: 767px) 88vw, 504px"
                  quality={80}
                />
              </div>
              {block.leftCaption && <p class="text-center mt-1">{block.leftCaption}</p>}
            </div>
            <div>
              <div class:list={[rightRadius, { 'img-frame': Boolean(frame), 'img-zoom': Boolean(block.rightZoom) }]} style={rightStyle}>
                <Image
                  src={right.src}
                  alt={right.alt}
                  widths={[400, 640, 900]}
                  sizes="(max-width: 767px) 88vw, 504px"
                  quality={80}
                />
              </div>
              {block.rightCaption && <p class="text-center mt-1">{block.rightCaption}</p>}
            </div>
          </div>
        );
      }
      case 'list':
        return (
          <ul class="content-list">
            {block.items.map((item: string) => (
              <li set:html={item} />
            ))}
          </ul>
        );
      case 'button':
        return (
          <p
            class:list={['text-center', block.padY ? 'btn-pad' : 'mt-2']}
            style={block.padY ? `--btn-pad: ${block.padY}px` : undefined}
          >
            <a class="btn btn--primary" href={block.href}>
              {block.label}
            </a>
          </p>
        );
      case 'video': {
        const q = block.srcExtra ? `?${block.srcExtra}` : '?feature=oembed';
        return (
          <div class="video-wrap">
            <iframe
              src={`https://www.youtube.com/embed/${block.youtubeId}${q}`}
              title={block.title}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            />
          </div>
        );
      }
      case 'html':
        return <div set:html={block.html} />;
      default:
        return null;
    }
  })
}
