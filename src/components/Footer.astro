---
const year = new Date().getFullYear();
---

<footer class="site-footer" id="footer">
  <div class="site-footer__inner">
    <div class="site-footer__left">
      <h4>Pages</h4>
      <ul class="footer-pages">
        <li><a href="/">Home</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/faq">FAQ</a></li>
        <li><a href="/links">Helpful Links</a></li>
      </ul>
    </div>

    <div class="site-footer__center">
      <div class="social-row">
        <a href="https://www.instagram.com/treehuggers.winnipeg/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5zm5 5a5 5 0 100 10 5 5 0 000-10zm6.5-.9a1.1 1.1 0 11-2.2 0 1.1 1.1 0 012.2 0zM12 9a3 3 0 110 6 3 3 0 010-6z"/></svg>
        </a>
        <a href="http://www.facebook.com/treehuggerswpg" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H8v3h3v7h3v-7h3l1-3h-4V9c0-.6.4-1 1-1z"/></svg>
        </a>
        <a href="mailto:info@treehuggerswinnipeg.com" aria-label="Email">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V6a2 2 0 00-2-2zm0 4l-8 5L4 8V6l8 5 8-5v2z"/></svg>
        </a>
      </div>
      <a class="btn btn--back-top" href="#">Back To Top</a>
    </div>

    <div class="site-footer__right">
      <p><a href="tel:+12042970767">(204) 297-0767</a></p>
      <p><a href="mailto:info@treehuggerswinnipeg.com">info@treehuggerswinnipeg.com</a></p>
      <p class="footer-service-area">Serving Winnipeg and Southern Manitoba</p>
      <p class="footer-copy">&copy; {year} Treehuggers Winnipeg. All Rights Reserved.</p>
    </div>
  </div>
</footer>

<script>
  // Smooth-scroll "back" links that point at the top of the page.
  document.querySelectorAll('a[href="#"]').forEach((link) => {
    if (!link.textContent || !link.textContent.toLowerCase().includes('back')) return;
    link.addEventListener('click', (event) => {
      event.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });
</script>
